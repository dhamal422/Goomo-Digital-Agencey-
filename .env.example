# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Connection String (Optional - defaults to auto in-memory hybrid simulation if omitted)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/agency_db?retryWrites=true&w=majority"
